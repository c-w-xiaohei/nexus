{
  "name": "@nexus-js/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --force",
    "build": "astro build --force && pnpm check:links",
    "preview": "astro preview",
    "typecheck": "astro check",
    "lint": "oxlint src scripts",
    "format": "prettier --write \"src/**/*.astro\" \"content/docs/**/*.mdx\"",
    "format:check": "prettier --check \"src/**/*.astro\" \"content/docs/**/*.mdx\"",
    "test": "pnpm check:links",
    "check:links": "node scripts/check-links.mjs"
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@astrojs/markdown-remark": "7.3.1",
    "@astrojs/mdx": "8.0.1",
    "@astrojs/react": "6.0.5",
    "@tailwindcss/vite": "4.3.0",
    "astro": "7.3.2",
    "fumadocs-core": "16.15.9",
    "fumadocs-ui": "16.15.9",
    "lucide-react": "0.577.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.4",
    "tailwindcss": "4.3.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "cheerio": "1.2.0",
    "prettier": "3.8.1",
    "prettier-plugin-astro": "1.0.0",
    "typescript": "6.0.3"
  }
}
