---
import { renderMermaidSVG } from "beautiful-mermaid";

interface Props {
  chart: string;
  caption: string;
  showCaption?: boolean;
  compact?: boolean;
}

const { chart, caption, showCaption = true, compact = false } = Astro.props;
// Render trusted documentation at build time; the browser only receives SVG.
const rendered = renderMermaidSVG(chart, {
  bg: "var(--color-fd-card)",
  fg: "var(--color-fd-foreground)",
  accent: "var(--color-fd-primary)",
  muted: "var(--color-fd-muted-foreground)",
  border: "var(--color-fd-border)",
  font: "Space Grotesk Variable",
  transparent: true,
  padding: 16,
  ...(compact ? { layerSpacing: 32, nodeSpacing: 56 } : {}),
});
// beautiful-mermaid 1.1.3 already draws start markers pointing backwards.
// auto-start-reverse flips them again, hiding their tips underneath source nodes.
const svg = rendered.replace(
  /(<marker id="arrowhead-start[^"]*"[^>]*orient=)"auto-start-reverse"/g,
  '$1"auto"',
);
---

<figure class="not-prose my-6 rounded-lg border border-fd-border bg-fd-card p-4">
  <div
    class="overflow-x-auto [&>svg]:mx-auto [&>svg]:h-auto [&>svg]:max-w-full"
    role="img"
    aria-label={caption}
    data-mermaid
    set:html={svg}
  />
  {showCaption && (
    <figcaption class="mt-3 text-center text-sm text-fd-muted-foreground">
      {caption}
    </figcaption>
  )}
</figure>
