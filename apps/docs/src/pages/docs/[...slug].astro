---
import { render, type CollectionEntry } from "astro:content";
import defaultMdxComponents from "fumadocs-ui/mdx";
import CodeBlock from "../../components/code-block.astro";
import InstallCommand from "../../components/install-command.astro";
import Mermaid from "../../components/mermaid.astro";
import { Steps, Step } from "fumadocs-ui/components/steps";
import Layout from "../../components/layout.astro";
import { Docs } from "../../components/docs";
import { source } from "../../lib/source";
import { docsUrl, i18n, type Locale } from "../../lib/i18n";

interface Props {
  entry: CollectionEntry<"docs">;
  locale: Locale;
  slugs: string[];
}

export function getStaticPaths() {
  return source.getPages().map((page) => ({
    params: {
      slug:
        page.url.slice("/nexus/docs/".length).replace(/\/$/, "") || undefined,
    },
    props: { entry: page.data.entry, locale: page.locale, slugs: page.slugs },
  }));
}

const { entry, locale, slugs } = Astro.props;
const { Content, headings } = await render(entry);
const languageUrls = Object.fromEntries(
  i18n.languages.map((language) => {
    const page =
      source.getPage(slugs, language) ?? source.getPage([], language);
    return [language, page ? docsUrl(page.slugs, language) : undefined];
  }),
);
const alternates = i18n.languages.flatMap((language) => {
  const page = source.getPage(slugs, language);
  return page ? [{ locale: language, url: docsUrl(page.slugs, language) }] : [];
});
const toc = headings.map((heading) => ({
  depth: heading.depth,
  title: heading.text,
  url: `#${heading.slug}`,
}));
---

<Layout
  title={entry.data.title}
  description={entry.data.description}
  locale={locale}
  alternates={alternates}
>
  <Docs
    tree={source.getPageTree(locale)}
    pathname={Astro.url.pathname}
    slugs={slugs}
    toc={toc}
    locale={locale}
    languageUrls={languageUrls}
    client:load
  >
    <h1 class="doc-title">{entry.data.title}</h1>
    <p class="doc-description">{entry.data.description}</p>
    <div class="prose flex-1 min-w-0">
      <Content
        components={{
          ...defaultMdxComponents,
          pre: CodeBlock,
          InstallCommand,
          Mermaid,
          Steps,
          Step,
        }}
      />
    </div>
    <a
      class="edit-link"
      href={`https://github.com/c-w-xiaohei/nexus/edit/main/apps/docs/${entry.filePath}`}
    >
      {locale === "zh-CN" ? "在 GitHub 上编辑此页" : "Edit this page on GitHub"}
    </a>
  </Docs>
</Layout>
