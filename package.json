{
  "name": "nexus-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "benchmark:serializers": "pnpm --filter @nexus-js/core benchmark:serializers",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "lint:force": "turbo run lint --force",
    "typecheck": "turbo run typecheck",
    "format:check": "oxfmt --check .",
    "prepare": "husky",
    "format": "oxfmt --write \"**/*.{ts,tsx,md}\"",
    "release": "turbo run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "2.29.8",
    "husky": "9.1.7",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "turbo": "2.8.10",
    "typescript": "7.0.2",
    "vitest": "4.0.18"
  },
  "packageManager": "pnpm@10.5.2"
}
