{
  "name": "@nexus-js/node-ipc",
  "version": "0.5.1",
  "description": "Node IPC adapter for Nexus framework",
  "private": false,
  "license": "MIT",
  "author": "Carson Yu",
  "repository": {
    "type": "git",
    "url": "https://github.com/c-w-xiaohei/nexus.git",
    "directory": "packages/node-ipc"
  },
  "keywords": [
    "nexus",
    "node",
    "ipc",
    "unix-socket"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "dev": "node ../../scripts/watch-package.mjs",
    "test": "pnpm build && vitest run --pool=threads",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nexus-js/core": "workspace:*",
    "better-result": "3.0.1"
  },
  "devDependencies": {
    "@types/node": "24.10.2",
    "typescript": "7.0.2",
    "vite": "7.3.1",
    "vitest": "4.0.18"
  },
  "peerDependencies": {
    "@nexus-js/core": ">=1.0.0"
  }
}
