{
  "name": "@nexus-js/chrome",
  "version": "0.4.0",
  "description": "Chrome extension adapter for Nexus framework",
  "private": false,
  "license": "MIT",
  "author": "Carson Yu",
  "repository": {
    "type": "git",
    "url": "https://github.com/c-w-xiaohei/nexus.git",
    "directory": "packages/chrome"
  },
  "keywords": [
    "nexus",
    "chrome-extension",
    "ipc",
    "cross-context"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "dev": "node ../../scripts/watch-package.mjs",
    "test": "vitest run",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nexus-js/core": "workspace:*"
  },
  "devDependencies": {
    "@types/chrome": "0.1.36",
    "@vitejs/plugin-react-swc": "4.2.3",
    "typescript": "7.0.2",
    "vite": "7.3.1",
    "vitest": "4.0.18"
  },
  "peerDependencies": {
    "@nexus-js/core": ">=1.0.0"
  }
}
