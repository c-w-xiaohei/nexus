{
  "name": "@nexus-js/iframe",
  "version": "0.3.1",
  "description": "Iframe postMessage adapter for Nexus framework",
  "private": false,
  "license": "MIT",
  "author": "Carson Yu",
  "repository": {
    "type": "git",
    "url": "https://github.com/c-w-xiaohei/nexus.git",
    "directory": "packages/iframe"
  },
  "keywords": [
    "nexus",
    "iframe",
    "postmessage"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "dev": "node ../../scripts/watch-package.mjs",
    "test": "vitest run src",
    "test:coverage": "vitest run src --coverage",
    "test:browser": "playwright test",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nexus-js/core": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "@vitest/coverage-v8": "4.0.18",
    "typescript": "7.0.2",
    "vite": "7.3.1",
    "vitest": "4.0.18"
  },
  "peerDependencies": {
    "@nexus-js/core": ">=0.4.0"
  }
}
