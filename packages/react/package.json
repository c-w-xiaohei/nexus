{
  "name": "@nexus-js/react",
  "version": "0.7.0",
  "description": "React bindings for Nexus instances, service proxy status, and Nexus State",
  "private": false,
  "license": "MIT",
  "author": "Carson Yu",
  "repository": {
    "type": "git",
    "url": "https://github.com/c-w-xiaohei/nexus.git",
    "directory": "packages/react"
  },
  "keywords": [
    "nexus",
    "react",
    "state",
    "cross-context"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "dev": "node ../../scripts/watch-package.mjs",
    "test:dist": "pnpm run build && node scripts/check-dist-no-react-internals.mjs",
    "test:react19-import": "pnpm run build && node scripts/check-react19-static-import.mjs",
    "test": "vitest run",
    "pretest:browser": "pnpm --filter @nexus-js/core build && pnpm --filter @nexus-js/iframe build && pnpm --filter @nexus-js/react build",
    "test:browser": "playwright test",
    "test:integration:file": "vitest run",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.browser.json",
    "typecheck:browser": "tsc --noEmit -p tsconfig.browser.json"
  },
  "peerDependencies": {
    "@nexus-js/core": ">=1.0.0",
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "devDependencies": {
    "@nexus-js/core": "workspace:*",
    "@nexus-js/iframe": "workspace:*",
    "@playwright/test": "1.57.0",
    "@testing-library/react": "16.3.0",
    "@types/react": "18.3.24",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react-swc": "4.2.3",
    "jsdom": "26.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "7.0.2",
    "vite": "7.3.1",
    "vitest": "4.0.18"
  }
}
